{
    // Python del entorno del proyecto (ver "Ejecutar" en el README)
    "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",

    // "python" en la terminal = el del .venv, sin ejecutar Activate.ps1 (la política de PowerShell lo bloquea):
    // cada terminal nueva arranca con la carpeta del entorno al inicio del PATH
    "terminal.integrated.env.windows": {
        "PATH": "${workspaceFolder}\\.venv\\Scripts;${env:PATH}",
        "VIRTUAL_ENV": "${workspaceFolder}\\.venv"
    },
    "python.terminal.activateEnvironment": false,

    // Pestaña Testing: las pruebas son unittest, en tests/
    "python.testing.unittestEnabled": true,
    "python.testing.pytestEnabled": false,
    "python.testing.unittestArgs": ["-v", "-s", "./tests", "-p", "test_*.py", "-t", "."],

    // Archivos generados que no aportan al buscar ni al explorar
    "files.exclude": {
        "**/__pycache__": true
    },
    "search.exclude": {
        ".venv": true,
        "respaldos": true,
        "static/productos": true
    }
}
